<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ATS: allow cleartext HTTP to local-network hosts (.local hostnames,
	     link-local, and LAN addresses). Raw IPs are already exempt, which is
	     why Bonjour discovery worked while manual hostname connects failed
	     with "server unreachable". Kept scoped to local networking. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE).
	     These have to live in a real plist because INFOPLIST_KEY_ only
	     encodes scalar settings: an array (NSBonjourServices) or a nested
	     dictionary (App Transport Security) is silently dropped. Without
	     NSBonjourServices, iOS refuses local-network access outright, never
	     shows the permission prompt, and never lists the app under Settings
	     > Privacy & Security > Local Network. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_stacks._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
